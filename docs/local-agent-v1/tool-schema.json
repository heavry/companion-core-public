            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "computer_mouse_click",
      "description": "点击一个刚观察到的元素；优先使用 element_token，只有自绘界面才使用坐标。",
      "parameters": {
        "type": "object",
