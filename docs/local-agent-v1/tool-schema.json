              "cancel",
              "open"
            ]
          },
          "delivery_mode": {
            "type": "string",
            "enum": [
              "background",
              "foreground"
            ]
          },
          "session": {
            "type": "string",
            "maxLength": 80
          },
          "target_description": {
            "type": "string",
            "maxLength": 240,
            "description": "用人类可读文字说明要操作的控件或结果；Companion 用它执行高风险硬边界判断，不传给 Cua Driver。"
          }
        },
        "oneOf": [
          {
            "required": [
              "element_token"
            ]
          },
          {
            "required": [
              "element_index",
              "snapshot_id",
