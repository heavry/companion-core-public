{
  "version": 1,
  "tools": [
    {
      "name": "read_file",
      "description": "读取授权 workspace 内的小型文本文件；binary 与大型文件只返回 metadata。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "max_lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        }
      }
    },
    {
      "name": "list_directory",
      "description": "列出授权 workspace 内目录，不进行全盘扫描。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    },
    {
      "name": "search_files",
      "description": "在授权 workspace 内按文本或文件名搜索，跳过 binary 与大型文件。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "mode": {
            "type": "string",
            "enum": [
              "content",
              "name"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      }
    },
    {
      "name": "write_file",
      "description": "在授权 workspace 内新建文本文件；已存在的文件必须使用带前置条件的 fs_patch。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "content": {
            "type": "string",
            "maxLength": 1048576
          }
        }
      }
    },
    {
      "name": "apply_patch",
      "description": "对授权 workspace 内文本文件执行精确 old_text/new_text patch；默认要求每段旧文本只出现一次。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "changes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "old_text",
                "new_text"
              ],
              "properties": {
                "old_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 262144
                },
                "new_text": {
                  "type": "string",
                  "maxLength": 262144
                },
                "expected_occurrences": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "read_image",
      "description": "读取用户提供的本机图片或授权项目图片，返回真实 vision input，不把图片写入长期聊天。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_pdf",
      "description": "按页读取本机 PDF 的文本。扫描版 PDF 没有文本时明确报告，需要截图/OCR。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "start_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "end_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "run_command",
      "description": "在授权项目的 macOS 沙箱执行命令。默认禁止联网、凭据、系统修改、删除。确需这些操作时 unrestricted=true，必须逐次确认。返回进程 ID；用 read_command_output 查看测试结果。",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 600000
          },
          "unrestricted": {
            "type": "boolean"
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_process_status",
      "description": "查看本任务启动的命令状态和退出码。",
      "parameters": {
        "type": "object",
        "properties": {
          "process_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "process_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_command_output",
      "description": "读取命令 artifact 的有限范围，cursor 是字节偏移。",
      "parameters": {
        "type": "object",
        "properties": {
          "process_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "max_chars": {
            "type": "integer",
            "minimum": 256,
            "maximum": 16000
          }
        },
        "required": [
          "process_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "take_screenshot",
      "description": "读取当前桌面的真实截图与应用信息；仅用于本轮 vision reasoning。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "computer": [
    {
