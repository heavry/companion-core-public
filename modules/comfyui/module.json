{
  "id": "comfyui",
  "name": "ComfyUI Image Generation",
  "version": "1.0.0",
  "type": "tool",
  "engine": "javascript",
  "description": "本地 ComfyUI 文生图模块。模型只传高级参数（prompt/style/aspect_ratio/purpose），workflow template 由本模块维护；生成结果经 Core Media Store 落盘并通过 image.created 事件通知客户端。默认地址 http://127.0.0.1:8188，可在 data/modules-config/comfyui.json 覆盖。",
  "permissions": ["network.fetch", "media.write"],
  "tools": [
    {
      "name": "generate_image",
      "description": "提交一次文生图任务并等待完成，返回 mediaId。",
      "sideEffect": "non_idempotent",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": { "type": "string" },
          "negative_prompt": { "type": "string" },
          "style": { "type": "string", "enum": ["casual", "anime", "photo", "illustration"] },
          "aspect_ratio": { "type": "string", "enum": ["1:1", "3:4", "4:3", "16:9"] },
          "purpose": { "type": "string", "enum": ["conversation", "wallpaper", "avatar"] }
        },
        "required": ["prompt"]
      }
    },
    {
      "name": "get_generation_status",
      "description": "查询某个 jobId 的当前状态。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "jobId": { "type": "string" } },
        "required": ["jobId"]
      }
    }
  ],
  "hooks": [],
  "triggers": []
}
